# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB (Docker: docker run -d --name procurement-mongo -p 27017:27017 mongo:7)
# or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/b2b_procurement

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:3000

# Set to 1 when deployed behind a hosting proxy (Render, Railway, Fly). Leave unset locally.
# TRUST_PROXY=1
