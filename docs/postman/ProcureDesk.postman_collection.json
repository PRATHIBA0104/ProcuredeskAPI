{
  "info": {
    "name": "ProcureDesk API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Register or Login first: it stores the token. Then Create vendor and Create contract store their ids for the other requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "vendorId",
      "value": ""
    },
    {
      "key": "contractId",
      "value": ""
    },
    {
      "key": "docId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationName\": \"Postman Org\",\n  \"name\": \"Pat Admin\",\n  \"email\": \"pat@postman.test\",\n  \"password\": \"Passw0rd1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (demo admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.procuredesk.in\",\n  \"password\": \"Demo@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Name\"\n}"
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Passw0rd1\",\n  \"newPassword\": \"Passw0rd2\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vendors",
      "item": [
        {
          "name": "Create vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Vendor\",\n  \"category\": \"software\",\n  \"status\": \"active\",\n  \"website\": \"https://example.com\",\n  \"contacts\": [\n    {\n      \"name\": \"Sam\",\n      \"email\": \"sam@example.com\",\n      \"isPrimary\": true\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('vendorId', pm.response.json().vendor._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List vendors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors?page=1&limit=10&search=&sort=name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "sort",
                  "value": "name"
                }
              ]
            }
          }
        },
        {
          "name": "Get vendor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/{{vendorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "{{vendorId}}"
              ]
            }
          }
        },
        {
          "name": "Update vendor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/{{vendorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "{{vendorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated from Postman\"\n}"
            }
          }
        },
        {
          "name": "Deactivate vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/{{vendorId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "{{vendorId}}",
                "deactivate"
              ]
            }
          }
        },
        {
          "name": "Activate vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/{{vendorId}}/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "{{vendorId}}",
                "activate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Contracts",
      "item": [
        {
          "name": "Create contract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"{{vendorId}}\",\n  \"title\": \"Postman MSA\",\n  \"status\": \"draft\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2027-12-31\",\n  \"totalValue\": 2400000,\n  \"noticePeriodDays\": 60,\n  \"pricingModel\": \"subscription\",\n  \"paymentTerms\": \"net_30\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('contractId', pm.response.json().contract._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List contracts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts?status=active&sort=endDate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "sort",
                  "value": "endDate"
                }
              ]
            }
          }
        },
        {
          "name": "Get contract",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}"
              ]
            }
          }
        },
        {
          "name": "Update contract",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noticePeriodDays\": 45\n}"
            }
          }
        },
        {
          "name": "Activate contract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Terminate contract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"terminated\"\n}"
            }
          }
        },
        {
          "name": "Upload document (pick a PDF in Body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('docId', pm.response.json().document._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}",
                "documents",
                "{{docId}}"
              ]
            }
          }
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contracts/{{contractId}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contracts",
                "{{contractId}}",
                "documents",
                "{{docId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "summary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security checks",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Foreign/unknown id -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "000000000000000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}